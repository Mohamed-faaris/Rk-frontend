{
  "name": "rk-website",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter server dev",
    "dev:full": "pnpm --parallel --filter web --filter server dev",
    "validate-env": "node scripts/validate-env.js",
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "start": "pnpm --filter api start",
    "server:api": "pnpm --filter server start",
    "server:full": "pnpm --filter server start:full"
  },
  "dependencies": {
    "apple-signin-auth": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.0",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.1",
    "sharp": "^0.34.5"
  }
}
