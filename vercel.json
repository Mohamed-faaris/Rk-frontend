{
  "version": 2,
  "installCommand": "corepack enable && pnpm install",
  "buildCommand": "pnpm --filter web build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
